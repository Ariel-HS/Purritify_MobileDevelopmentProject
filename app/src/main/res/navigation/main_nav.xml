<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/home_page">

    <fragment
        android:id="@+id/home_page"
        android:name="com.example.purritify.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_player"
            app:destination="@id/player"/>
        <action
            android:id="@+id/action_home_to_chart"
            app:destination="@id/chartFragment">
        </action>
    </fragment>
    <fragment
        android:id="@+id/my_library"
        android:name="com.example.purritify.MyLibraryFragment"
        android:label="fragment_my_library"
        tools:layout="@layout/fragment_my_library">
        <action
            android:id="@+id/action_library_to_player"
            app:destination="@id/player"/>
    </fragment>
    <fragment
        android:id="@+id/profile"
        android:name="com.example.purritify.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_player"
            app:destination="@id/player"/>
    </fragment>
    <fragment
        android:id="@+id/player"
        android:name="com.example.purritify.PlayerFragment"
        android:label="player"
        tools:layout="@layout/fragment_player">
            <argument
                android:name="songId"
                app:argType="integer"
                android:defaultValue="-1"/>
            <argument
                android:name="fromMiniplayer"
                app:argType="boolean"
                android:defaultValue="false"/>
            <argument
                android:name="mode"
                app:argType="string"
                android:defaultValue="offline"
                />

            <deepLink
                app:uri="purritify://song/{songId}"/>
    </fragment>
    <fragment
        android:id="@+id/chartFragment"
        android:name="com.example.purritify.ChartFragment"
        android:label="fragment_chart"
        tools:layout="@layout/fragment_chart">
        <action
            android:id="@+id/action_chart_to_home"
            app:destination="@id/home_page"/>
        <action
            android:id="@+id/action_chart_to_player"
            app:destination="@id/player"/>
        <argument
            android:name="chartType"
            app:argType="string"
            android:defaultValue="global"/>
    </fragment>

    <action
        android:id="@+id/action_global_player"
        app:destination="@id/player" />
</navigation>