<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileFragment"
    android:background="#000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="16dp">

        <!-- Profile Card -->
        <FrameLayout
            android:id="@+id/profileCardContainer"
            android:layout_width="122dp"
            android:layout_height="175dp"
            android:layout_marginTop="70dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Edit Profile Button -->
        <Button
            android:id="@+id/editProfileButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_profile"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#3E3F3F"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="24dp"
            android:layout_gravity="center_horizontal"
            android:minHeight="38dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profileCardContainer" />

        <!-- Statistics -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profileStatisticsContainer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="12dp"

            app:layout_constraintTop_toBottomOf="@id/editProfileButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Songs -->
            <FrameLayout
                android:id="@+id/profileSongsStatistics"
                android:layout_width="63.13dp"
                android:layout_height="41.65dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Liked -->
            <FrameLayout
                android:id="@+id/profileLikedStatistics"
                android:layout_width="63.13dp"
                android:layout_height="41.65dp"
                app:layout_constraintStart_toEndOf="@id/profileSongsStatistics"
                app:layout_constraintEnd_toStartOf="@id/profileListenedStatistics"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Listened -->
            <FrameLayout
                android:id="@+id/profileListenedStatistics"
                android:layout_width="63.13dp"
                android:layout_height="41.65dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Mini Player -->
    <com.example.purritify.ui.player.MiniplayerView
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
