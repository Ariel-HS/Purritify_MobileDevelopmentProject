<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:paddingTop="32dp"
    android:paddingHorizontal="16dp">

    <!-- Buttons -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toTopOf="parent"
        >

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/caret"
            android:contentDescription="@string/close_player_screen"
            android:src="@drawable/caret"
            android:layout_margin="4dp"
            app:layout_constraintBaseline_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- More Button -->
        <ImageButton
            android:id="@+id/moreButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/more"
            android:contentDescription="@string/close_player_screen"
            android:src="@drawable/more"
            android:layout_margin="4dp"
            app:layout_constraintBaseline_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    
    <!-- Song Cover -->
    <ImageView
        android:id="@+id/songCover"
        android:layout_width="327dp"
        android:layout_height="327dp"
        android:contentDescription="@string/song_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp" />

    <!-- Song Data -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/songDataContainer"
        android:layout_width="0dp"
        android:layout_height="51dp"
        app:layout_constraintStart_toStartOf="@id/songCover"
        app:layout_constraintEnd_toEndOf="@id/songCover"
        app:layout_constraintTop_toBottomOf="@id/songCover"
        android:layout_marginTop="24dp"
        >

        <!-- Title -->
        <TextView
            android:id="@+id/songTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:maxLines="1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"

            app:layout_constraintWidth_percent="0.8"
            app:layout_constraintStart_toStartOf="@id/songDataContainer"
            app:layout_constraintTop_toTopOf="@id/songDataContainer"
            />
        
        <!-- Artist -->
        <TextView
            android:id="@+id/songArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/artist"
            android:maxLines="1"
            android:textSize="16sp"
            android:textColor="#B3B3B3"
            android:layout_marginTop="3dp"

            app:layout_constraintWidth_percent="0.8"
            app:layout_constraintStart_toStartOf="@id/songDataContainer"
            app:layout_constraintTop_toBottomOf="@id/songTitle"
            />

        <!-- More Button -->
        <ImageButton
            android:id="@+id/heartButton"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/heart"
            android:contentDescription="@string/close_player_screen"
            android:src="@drawable/heart"
            android:layout_margin="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Duration Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/durationBar"
        android:layout_width="0dp"
        android:layout_height="45dp"
        app:layout_constraintStart_toStartOf="@id/songCover"
        app:layout_constraintEnd_toEndOf="@id/songCover"
        app:layout_constraintTop_toBottomOf="@id/songDataContainer"
        android:layout_marginTop="12dp">

        <SeekBar
            android:id="@+id/songSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:progressTint="@color/white"
            android:thumbTint="@color/white"
            android:progressBackgroundTint="@color/white"
            android:backgroundTint="@color/white"
            android:splitTrack="false"
            android:padding="0dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"

            android:layout_marginStart="-10dp"
            android:layout_marginEnd="-10dp"/>

        <TextView
            android:id="@+id/songDurationAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#B2B2B2"
            android:text="@string/_0_00"
            tools:ignore="SmallSp"

            app:layout_constraintTop_toBottomOf="@id/songSeekBar"
            app:layout_constraintStart_toStartOf="@id/songSeekBar"

            android:layout_marginTop="2dp"
            android:layout_marginStart="12dp"
            />

        <TextView
            android:id="@+id/songDurationTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#B2B2B2"
            android:text="@string/_0_00"
            tools:ignore="SmallSp"

            app:layout_constraintTop_toBottomOf="@id/songSeekBar"
            app:layout_constraintEnd_toEndOf="@id/songSeekBar"

            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Controller -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/songController"
        android:layout_width="189dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toBottomOf="@id/durationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <!-- Prev -->
        <ImageButton
            android:id="@+id/prevButton"
            android:layout_width="18dp"
            android:layout_height="20.35dp"
            android:background="@drawable/prev"
            android:contentDescription="@string/previous_song"
            android:src="@drawable/prev"
            android:layout_margin="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Pause / Play (Load Dynamically) -->
        <FrameLayout
            android:id="@+id/pausePlayContainer"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="parent">

            <!-- Play -->
            <ImageView
                android:id="@+id/playIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/play_button"
                android:src="@drawable/play"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:alpha="0.0"
                android:layout_marginStart="4dp"/>

            <!-- Pause -->
            <ImageView
                android:id="@+id/pauseIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/pause_button"
                android:src="@drawable/pause"
                android:scaleType="centerInside"
                android:visibility="visible"
                android:alpha="1.0" />

        </FrameLayout>
        
        <!-- Next -->
        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="18dp"
            android:layout_height="20.35dp"
            android:background="@drawable/next"
            android:contentDescription="@string/next_song"
            android:src="@drawable/next"
            android:layout_margin="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>