<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/cardView"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    android:layout_gravity="center"
    android:clipToPadding="false"
    android:clipChildren="false"

    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"

    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:padding="12dp"
        android:clipToPadding="false">

        <!-- Cover -->
        <ImageView
            android:id="@+id/songCover"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/song_cover"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Song Data -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="vertical"

            android:layout_marginStart="14dp"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/songCover" >

            <!-- Title -->
            <TextView
                android:id="@+id/songTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/title"
                android:textColor="@color/white"/>

            <!-- Artist -->
            <TextView
                android:id="@+id/songArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="10sp"
                android:text="@string/artist"
                android:textColor="#B3B3B3"
                tools:ignore="SmallSp"

                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Controller -->
        <LinearLayout
            android:id="@+id/songControllerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Add Button -->
            <ImageButton
                android:id="@+id/addButton"
                android:contentDescription="@string/liked"
                android:src="@drawable/like"
                android:background="@android:color/transparent"
                android:layout_width="16dp"
                android:layout_height="16dp"/>

            <!-- Share Button -->
            <ImageButton
                android:id="@+id/shareButton"
                android:contentDescription="@string/share"
                android:src="@drawable/share"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"/>

            <!-- Pause / Play Button -->
            <FrameLayout
                android:id="@+id/pausePlayContainer"
                android:layout_width="13dp"
                android:layout_height="16dp"
                android:clickable="true"
                android:focusable="true"

                android:layout_marginStart="20dp"
                android:layout_marginEnd="12dp">

                <!-- Play -->
                <ImageView
                    android:id="@+id/playIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/play_button"
                    android:src="@drawable/play_miniplayer"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    android:alpha="0.0" />

                <!-- Pause -->
                <ImageView
                    android:id="@+id/pauseIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/pause_button"
                    android:src="@drawable/pause_miniplayer"
                    android:scaleType="centerInside"
                    android:visibility="visible"
                    android:alpha="1.0" />

            </FrameLayout>

        </LinearLayout>

        <!-- Duration Bar -->
        <SeekBar
            android:id="@+id/songSeekBar"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:progress="50"
            android:thumb="@null"
            android:clickable="false"
            android:focusable="false"
            android:progressDrawable="@drawable/mini_seekbar_progress"

            android:layout_marginBottom="-12.4dp"
            android:layout_marginStart="-20dp"
            android:layout_marginEnd="-20dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>